# --- Обязательные ---
# Строка подключения MongoDB (например, MongoDB Atlas)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# Имя базы данных
MONGODB_DB=medscribe
# Секрет для подписи сессий (минимум 32 символа). Сгенерировать: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Учётная запись администратора, создаётся автоматически при первом запуске (если пользователей ещё нет)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Администратор

# Демо-врач (необязательно), создаётся при первом запуске вместе с администратором
DEMO_DOCTOR_EMAIL=doctor@example.com
DEMO_DOCTOR_PASSWORD=change-me-strong-password
DEMO_DOCTOR_NAME=Иванов Иван Иванович

# --- ИИ и распознавание речи (OpenAI-совместимый API; по умолчанию Groq) ---
GROQ_API_KEY=gsk_...
# AI_BASE_URL=https://api.groq.com/openai/v1
# Модель распознавания речи
# STT_MODEL=whisper-large-v3
# Модель для структурирования и заполнения шаблонов
# LLM_MODEL=openai/gpt-oss-120b
